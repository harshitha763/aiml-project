# ===== IntelliMeet AI Environment Configuration =====
# Copy this file to .env and fill in your values.
# Never commit your actual .env file.

# Application
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
DEMO_MODE=true

# Database
DATABASE_URL=sqlite:///./intellimeet.db

# File Upload
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_SIZE_MB=500

# ===== AI Provider Configuration =====
# Leave blank to use demo/fallback mode with sample data.
# When blank, AI features return clearly labeled demonstration content.

# OpenAI (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# OpenAI-compatible local endpoint (optional, e.g. LM Studio, Ollama)
# OPENAI_BASE_URL=http://localhost:1234/v1

# Azure OpenAI (optional)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# Groq (optional)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Transcription
TRANSCRIPTION_PROVIDER=
# Options: openai_whisper, local, demo (blank = demo)
